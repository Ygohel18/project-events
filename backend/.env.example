# Server Port (5001 avoids macOS AirPlay receiver collision on 5000)
PORT=5001

# MySQL Database Configuration
DB_HOST=localhost
DB_USER=root
DB_PASSWORD=
DB_NAME=event_management
DB_PORT=3306

# JWT Authentication Secret
JWT_SECRET=college_event_hub_secret_key_2025

# Frontend Client URL & Allowed CORS Origins
# Supports single URL, comma-separated URLs, or wildcard subdomains (e.g. *.yourdomain.com)
CLIENT_URL=http://localhost:3000
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
# ROOT_DOMAIN=yourdomain.com

# SMTP Email Configuration (Nodemailer)
# If credentials are left blank, emailService operates in graceful simulation / test preview mode
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM="CampusEvents <noreply@campusevents.edu>"
